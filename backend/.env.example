# Mockora Backend Configuration
# =================================

# AI API Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL Configuration (Optional - SQLite fallback is active if empty)
# Get from your Supabase project dashboard -> Settings -> API / Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Transactional Email Service Configuration
# Support for Resend, SendGrid, or direct SMTP
EMAIL_SERVICE=smtp
EMAIL_API_KEY=
EMAIL_FROM=hello@mockora.ai
EMAIL_FROM_NAME="Mockora AI Coach"

# SMTP Settings (Used if EMAIL_SERVICE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# App Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
